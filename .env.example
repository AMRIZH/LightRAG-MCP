# LightRAG local host configuration (template)
LIGHTRAG_RUNTIME_TARGET=host

# Server
HOST=127.0.0.1
PORT=9621
WEBUI_TITLE='Academic Graph KB'
WEBUI_DESCRIPTION='Local LightRAG for citation-aware writing'
VERBOSE=False

# Input and storage
INPUT_DIR=./data/inputs_prepared
WORKING_DIR=./data/rag_storage
TIKTOKEN_CACHE_DIR=./data/tiktoken

# Query defaults for academic workflows
ENABLE_LLM_CACHE=true
TOP_K=40
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
KG_CHUNK_PICK_METHOD=VECTOR

# Document processing
SUMMARY_LANGUAGE=English
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
MAX_UPLOAD_SIZE=104857600
MAX_FILE_PATHS=100

# Concurrency
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
EMBEDDING_BATCH_NUM=10

# LLM (DeepSeek)
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_BINDING_API_KEY=REVOKE_AND_REPLACE
LLM_MODEL=deepseek-chat
OPENAI_LLM_TEMPERATURE=0.2
OPENAI_LLM_MAX_TOKENS=9000
LLM_TIMEOUT=180

# Embedding (Voyage AI)
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.voyageai.com/v1
# Primary key used first
EMBEDDING_BINDING_API_KEY_MAIN=REVOKE_AND_REPLACE
# Fallback key used when primary fails at startup preflight
EMBEDDING_BINDING_API_KEY_FALLBACK=REVOKE_AND_REPLACE
# Optional legacy single-key variable (kept for compatibility)
# EMBEDDING_BINDING_API_KEY=REVOKE_AND_REPLACE
# Selected embedding model (high quality)
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false

# Reranker: start disabled for stable boot; enable after compatibility validation
RERANK_BINDING=null
# RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
# RERANK_BINDING_API_KEY=REVOKE_AND_REPLACE
RERANK_BY_DEFAULT=False
MIN_RERANK_SCORE=0.0

# Local default storage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# Optional API access key for external clients
# LIGHTRAG_API_KEY=replace_with_strong_key
